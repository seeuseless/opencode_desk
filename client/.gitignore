# ============================================================
# client/（Electron 桌面端）.gitignore
# 原仓库根的规则迁到这里，路径前缀相应改成 client/ 内相对路径。
# ============================================================

node_modules
out
dist
*.local
.DS_Store

# electron-builder 生成的更新元数据：只在"构建产物"里出现（dist/latest.yml），
# 由 CI 上传到 Release 附件，不入源码库；resources/update.json 是构建时生成的仓库坐标，要入库
/latest.yml

# 临时探针产物
.probe/
/.qn-verify-config
/.qn-verify-data
/.gitcheck.txt

# computer-use-mcp 自包含副本（scripts/prepare-cu-mcp.mjs 生成，dist 前自动重建，不入库）
/resources/mcp/cu-mcp/

# yarn 本地缓存
/.yarn-cache/

# 本地调试脚本与输出（不入库）
/qn_*
*.log

# ZCode 工具目录
.zcode/

# 禁止生成 nul / null 文件
/nul
/nul.*
/null
/null.*
