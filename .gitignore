# ============================================================
# monorepo 根 .gitignore
# 客户端（client/）与服务端（server/）各自还有一份更细的，
# 这里只放跨端共用的与仓库级产物。
# ============================================================

# 通用
*.local
.DS_Store
Thumbs.db
*.log

# 工作区记忆：只跟踪长期笔记，日期日志不入库
.workbuddy/memory/*
!.workbuddy/memory/MEMORY.md
!.workbuddy/memory/memory.md
.workbuddy/tmp/

# 临时探针产物
.probe/
/.qn-verify-config
/.qn-verify-data
/.gitcheck.txt

# 打包配置验证产物：electron-builder --dir --config.directories.output=dist-verify
# 用来只验证配置解析与文件收集、不出安装包（改完 electron-builder.yml 后的自检手段）。
# 体积与 dist 同量级（~550MB），绝不能入库。
client/dist-verify/

# ZCode 工具目录
.zcode/

# monorepo 根不该有 package-lock.json：桌面端的清单在 client/package-lock.json。
# 根 package.json 已在 monorepo 迁移那次删除（6478e58），这里挡掉误在根跑
# `npm install` 生成出来的孤儿锁文件（无对应 package.json，且锁的是迁移前版本）。
/package-lock.json

# 本地调试脚本与输出（不入库）
/qn_*

# 禁止上传 .git 目录内容
/.git/

# 禁止生成 nul / null 文件（Windows 下误用 > nul 会真的造出这些文件）
/nul
/nul.*
/null
/null.*

# ---------------- 服务端（server/）----------------
# Go 构建产物
/server/bin/
/server/server
/server/server.exe
# SQLite 数据库（本地一体化模式的运行时数据，绝不入库）
/server/*.db
/server/*.db-wal
/server/*.db-shm
# 前端构建产物：由 go:embed 进二进制，源码在 server/web/
#   server/web/dist     —— 由 electron-builder 的 extraResources 引用说明残留
#   server/internal/web/dist —— go:embed 实际打包的那份（vite outDir 指向这里）
/server/web/dist/
/server/internal/web/dist/
/server/web/node_modules/
# 本地配置（含密钥）
/server/.env
/server/.env.local
