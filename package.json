{
  "name": "qingniao",
  "version": "0.0.1",
  "description": "青鸟 QingNiao — 开源工作助手（Electron 桌面壳 + OpenCode agent 内核）",
  "homepage": "https://github.com/seeuseless/opencode_desk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seeuseless/opencode_desk.git"
  },
  "keywords": [
    "electron",
    "ai",
    "agent",
    "opencode",
    "desktop",
    "productivity"
  ],
  "main": "out/main/index.js",
  "author": "qingniao",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:mac:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac"
  },
  "dependencies": {
    "computer-use-mcp": "^1.8.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.46.0",
    "opencode-ai": "^1.18.31",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
